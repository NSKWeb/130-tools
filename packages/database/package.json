{
  "name": "@130tools/database",
  "version": "1.0.0",
  "description": "Prisma database client and schema",
  "main": "./dist/client.js",
  "module": "./dist/client.mjs",
  "types": "./dist/client.d.ts",
  "exports": {
    ".": {
      "import": "./dist/client.mjs",
      "require": "./dist/client.js",
      "types": "./dist/client.d.ts"
    },
    "./prisma": {
      "import": "./dist/prisma.mjs",
      "require": "./dist/prisma.js",
      "types": "./dist/prisma.d.ts"
    }
  },
  "scripts": {
    "build": "tsup src/client.ts --format cjs,esm --dts",
    "dev": "tsup src/client.ts --format cjs,esm --dts --watch",
    "db:generate": "prisma generate",
    "db:push": "prisma db push",
    "db:migrate": "prisma migrate dev",
    "db:studio": "prisma studio",
    "db:seed": "tsx src/seed.ts",
    "lint": "eslint src/**/*.ts",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@prisma/client": "^5.7.0"
  },
  "devDependencies": {
    "prisma": "^5.7.0",
    "tsup": "^8.0.0",
    "tsx": "^4.7.0",
    "typescript": "^5.3.0",
    "@types/node": "^20.0.0"
  },
  "peerDependencies": {
    "typescript": "^5.0.0"
  }
}
