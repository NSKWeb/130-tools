# Development Environment Variables
# Copy this file to .env.local and fill in your values

# Database
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/130tools_dev?schema=public"
DATABASE_POOL_SIZE=5

# Authentication (use simple values for development)
JWT_SECRET="dev-jwt-secret-min-32-characters-long"
JWT_EXPIRES_IN="24h"
REFRESH_TOKEN_SECRET="dev-refresh-token-secret"
REFRESH_TOKEN_EXPIRES_IN="7d"

# 3-Layer Security
SECURITY_QUESTION_ATTEMPTS=5
PASSWORD_MIN_LENGTH=8
ACCESS_KEY_EXPIRY_MINUTES=30
ACCOUNT_LOCKOUT_MINUTES=5

# AI Providers (optional for development)
GROQ_API_KEY=""
OPENROUTER_API_KEY=""
AI_DEFAULT_PROVIDER="groq"
AI_FALLBACK_PROVIDER="openrouter"
AI_RATE_LIMIT_PER_MINUTE=100

# Email Service (use console log in development)
EMAIL_SERVICE="console"
EMAIL_API_KEY=""
EMAIL_FROM="dev@localhost.com"
EMAIL_FROM_NAME="130 Tools Dev"

# Rate Limiting (relaxed for development)
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX_REQUESTS=1000
AUTH_RATE_LIMIT_MAX=10

# Security (lower rounds for faster dev builds)
BCRYPT_ROUNDS=10
CSRF_SECRET="dev-csrf-secret"
CSP_NONCE_SECRET="dev-csp-nonce"

# Application
NEXT_PUBLIC_APP_URL="http://localhost:3000"
NEXT_PUBLIC_API_URL="http://localhost:3000/api"
NODE_ENV="development"

# Redis (optional for development)
REDIS_URL=""
REDIS_CACHE_TTL=60

# File Storage
STORAGE_PROVIDER="local"
STORAGE_API_KEY=""
STORAGE_API_SECRET=""
MAX_FILE_SIZE=5242880 # 5MB

# Analytics & Monitoring (disabled in development)
GOOGLE_ANALYTICS_ID=""
SENTRY_DSN=""
LOG_LEVEL="debug"

# Payments (disabled in development)
STRIPE_PUBLIC_KEY=""
STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""

# Admin Credentials (simple values for development)
ADMIN_SECURITY_QUESTION="What is the dev password?"
ADMIN_SECURITY_ANSWER="dev"
ADMIN_PASSWORD_HASH="$2b$10$dev.hash.for.testing" # bcrypt hash of "password123"

# Feature Flags
ENABLE_AI_FEATURES=false
ENABLE_ANALYTICS=false
ENABLE_RATE_LIMITING=false
ENABLE_CACHE=false
