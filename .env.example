# Database
DATABASE_URL="postgresql://user:password@localhost:5432/130tools?schema=public"
DATABASE_POOL_SIZE=10

# Authentication
JWT_SECRET="your-super-secret-jwt-key-min-32-chars"
JWT_EXPIRES_IN="1h"
REFRESH_TOKEN_SECRET="your-refresh-token-secret"
REFRESH_TOKEN_EXPIRES_IN="7d"

# 3-Layer Security
SECURITY_QUESTION_ATTEMPTS=3
PASSWORD_MIN_LENGTH=12
ACCESS_KEY_EXPIRY_MINUTES=5
ACCOUNT_LOCKOUT_MINUTES=15

# AI Providers
GROQ_API_KEY="gsk_..."
OPENROUTER_API_KEY="sk-or-..."
AI_DEFAULT_PROVIDER="groq"
AI_FALLBACK_PROVIDER="openrouter"
AI_RATE_LIMIT_PER_MINUTE=60

# Email Service (for Layer 3 access keys)
EMAIL_SERVICE="sendgrid" # or "resend", "aws-ses"
EMAIL_API_KEY="..."
EMAIL_FROM="noreply@yourdomain.com"
EMAIL_FROM_NAME="130 Tools"

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100
AUTH_RATE_LIMIT_MAX=5

# Security
BCRYPT_ROUNDS=12
CSRF_SECRET="your-csrf-secret"
CSP_NONCE_SECRET="your-csp-nonce"

# Application
NEXT_PUBLIC_APP_URL="https://yourdomain.com"
NEXT_PUBLIC_API_URL="https://api.yourdomain.com"
NODE_ENV="production"

# Redis (for caching)
REDIS_URL="redis://localhost:6379"
REDIS_CACHE_TTL=3600

# File Storage (for uploads)
STORAGE_PROVIDER="cloudinary" # or "s3", "supabase"
STORAGE_API_KEY="..."
STORAGE_API_SECRET="..."
MAX_FILE_SIZE=10485760 # 10MB

# Analytics & Monitoring
GOOGLE_ANALYTICS_ID="G-..."
SENTRY_DSN="https://..."
LOG_LEVEL="info"

# Payments (if monetization enabled)
STRIPE_PUBLIC_KEY="pk_..."
STRIPE_SECRET_KEY="sk_..."
STRIPE_WEBHOOK_SECRET="whsec_..."

# Admin Credentials (for initial setup)
ADMIN_SECURITY_QUESTION="What is your favorite color?"
ADMIN_SECURITY_ANSWER="blue"
ADMIN_PASSWORD_HASH="$2b$12$..." # bcrypt hash

# Feature Flags
ENABLE_AI_FEATURES=true
ENABLE_ANALYTICS=true
ENABLE_RATE_LIMITING=true
ENABLE_CACHE=true
